# ==============================================================================
# Glyph CMS — copy to `.env` and fill in. Never commit real values.
# ==============================================================================

# --- Database ---------------------------------------------------------------
# MongoDB connection string (src/lib/db-connect.ts)
MONGODB=

# --- Auth.js / NextAuth v5 (src/auth.ts) ------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=

# Google Cloud Console -> APIs & Services -> Credentials
# NextAuth v5 auto-detects these by convention: AUTH_<PROVIDER>_ID / _SECRET
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Canonical site URL. Recommended in production so OAuth callbacks resolve
# correctly. Optional locally (defaults to http://localhost:3000).
AUTH_URL=

# --- AWS S3 (server-side, src/app/api/bucket/*) -----------------------------
AWS_BUCKET_NAME=
AWS_REGION=
AWS_KEY_ID=
AWS_S3_ACCESS_KEY=

# --- Public / client-side ----------------------------------------------------
# Base URL of this app, used for the OpenGraph image fallback.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Bucket identity exposed to the browser so the editor can tell which image
# URLs are ours and therefore safe to clean up. Must match the values above.
NEXT_PUBLIC_AWS_BUCKET_NAME=
NEXT_PUBLIC_AWS_REGION=
